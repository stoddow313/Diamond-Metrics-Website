{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://diamond-metrics-api.onrender.com/api/:path*"
    },
    {
      "source": "/card-station",
      "destination": "/card-station/index.html"
    },
    {
      "source": "/card-station/",
      "destination": "/card-station/index.html"
    },
    {
      "source": "/((?!api/|_poc/|card-station/).*)",
      "destination": "/index.html"
    }
  ]
}
